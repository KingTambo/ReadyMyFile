---
export const prerender = true;

import AuthHeader from '../../components/auth/AuthHeader';
import { HUBS, getHubBySlug, getHubLinks } from '../../lib/hubs';
import '../../styles/global.css';

export function getStaticPaths() {
  return HUBS.map((hub) => ({
    params: { category: hub.slug },
  }));
}

const slug = Astro.params.category!;
const hub = getHubBySlug(slug);

if (!hub) {
  return Astro.redirect('/');
}

const links = getHubLinks(hub);
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://readymyfile.vercel.app';
const canonical = `${site}/hub/${hub.slug}`;
const title = `${hub.title} Converters | ReadyMyFile`;
const description = hub.intro;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen font-sans text-slate-900 antialiased">
    <div class="page-bg min-h-screen">
      <header class="border-b border-slate-200/70 bg-white/70 backdrop-blur-md">
        <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-5 sm:px-6">
          <a
            href="/"
            class="font-display text-2xl tracking-tight text-slate-900 sm:text-3xl"
          >
            ReadyMyFile
          </a>
          <AuthHeader client:load />
        </div>
      </header>

      <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
        <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-1.5 text-xs text-slate-500 sm:text-sm">
          <a href="/" class="transition hover:text-slate-800">Home</a>
          <span aria-hidden="true" class="text-slate-300">/</span>
          <span class="font-medium text-slate-800">{hub.title}</span>
        </nav>

        <h1 class="font-display text-4xl tracking-tight text-slate-900 sm:text-5xl">
          {hub.title} converters
        </h1>
        <p class="mt-3 max-w-3xl text-base leading-relaxed text-slate-600">
          {hub.intro}
        </p>
        <p class="mt-2 text-sm text-slate-500">
          {links.length.toLocaleString()} converter pages in this category — searchable below for quick access.
        </p>

        <div class="mt-6">
          <label for="hub-filter" class="mb-1.5 block text-sm font-medium text-slate-700">
            Search converters
          </label>
          <input
            id="hub-filter"
            type="search"
            placeholder="Filter by bank, CRM, accounting tool…"
            class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm shadow-sm outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20"
          />
          <p id="hub-filter-count" class="mt-2 text-xs text-slate-400"></p>
        </div>

        <div
          id="hub-grid"
          class="mt-6 grid gap-2 sm:grid-cols-2"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                data-hub-link
                data-label={`${link.label} ${link.sourceLabel} ${link.destinationLabel}`.toLowerCase()}
                class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 shadow-sm transition hover:border-teal-300 hover:text-teal-800"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </main>

      <footer class="border-t border-slate-200/60 py-6 text-center text-xs text-slate-400">
        100% client-side · Files never leave your device
      </footer>
    </div>

    <script>
      const input = document.getElementById('hub-filter') as HTMLInputElement | null;
      const countEl = document.getElementById('hub-filter-count');
      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('[data-hub-link]')
      );

      const renderCount = (visible: number) => {
        if (!countEl) return;
        countEl.textContent =
          visible === links.length
            ? `Showing all ${links.length.toLocaleString()} converters`
            : `Showing ${visible.toLocaleString()} of ${links.length.toLocaleString()} converters`;
      };

      const applyFilter = () => {
        const q = (input?.value ?? '').trim().toLowerCase();
        let visible = 0;
        for (const link of links) {
          const label = link.dataset.label ?? '';
          const show = !q || label.includes(q);
          link.style.display = show ? '' : 'none';
          if (show) visible += 1;
        }
        renderCount(visible);
      };

      input?.addEventListener('input', applyFilter);
      applyFilter();
    </script>
  </body>
</html>
